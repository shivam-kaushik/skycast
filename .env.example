# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# ── Firebase (required for login / cross-device premium sync) ────────────────
# Get from: Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123

# ── Google Sign-In (required for Google auth) ────────────────────────────────
# Web client ID: Firebase console → Authentication → Sign-in method → Google → Web SDK configuration
# iOS client ID: CLIENT_ID in GoogleService-Info.plist (also put its REVERSED_CLIENT_ID in app.json → iosUrlScheme)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Android needs no value here — add your SHA-1 to the Android app in Firebase project settings

# ── OpenAI (required for AI chat, wardrobe advisor, trip briefing) ────────────
# Get from: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# ── RevenueCat (required for premium subscriptions) ───────────────────────────
# Get from: https://app.revenuecat.com → Project → API Keys
#
# Option A — single key (works for sandbox / both platforms):
EXPO_PUBLIC_RC_API_KEY=your_teststore_key_here
#
# Option B — separate keys per platform (use in production):
# EXPO_PUBLIC_RC_API_KEY_IOS=appl_...
# EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_...
#
# NOTE: If both options are set, Option B takes precedence per platform.
